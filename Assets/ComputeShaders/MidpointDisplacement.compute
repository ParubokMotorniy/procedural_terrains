#include "../../3rdparty/hlsl_noise/ashima/noise2D.hlsl"
#include "../../3rdparty/hlsl_noise/ashima/cellular2D.hlsl"
#include "../../3rdparty/hlsl_noise/common/stegu-math.hlsl"

RWTexture2D<float> Result;

uniform int threadDomainTexelWidth;
uniform int texelWidthDivided;
uniform uint texelWidthDivisionFactor; // 1,2,4,8...

uniform uint threadSubdomainsX;
uniform uint threadSubdomainsY;

uniform float octaveAmplitude;
uniform float noiseFrequency;
uniform float4 noiseDisplacement;
uniform float worleyFrequency;
uniform float perlinFrequency;

#define TWO_PI 6.283185307

// TODO: I may want to move the extra noise addition to the division loops
// TODO: can I employ gradients of noise here?
// TODO: consider using computebuffers prior to building a final texture

int2 terrainWrap(int2 a, int2 b)
{
    return (a % b + b) % b;
}

float sampleGaussBoxMuller(float2 u)
{
    const float a = sqrt(-2.0f * log(1.0f - u.x));
    const float b = TWO_PI * u.y;

    // return float2(cos(b), sin(b)) * a;
    return cos(b) * a;
}

float sampleGaussianNoise(float2 noiseTextureIdx)
{
    return sampleGaussBoxMuller(noiseTextureIdx);
}

float sampleNoise(float2 noiseTextureIdx)
{
    float randomCoord = sampleGaussianNoise(noiseTextureIdx);
    return snoise(randomCoord * perlinFrequency); // domain warping
}

float sampleWorleyNoise(float2 noiseTextureIdx)
{
#define RANGE_THRSH_CEIL 0.6
#define RANGE_THRSH_FLOOR 0.35
#define EPSILON 3.0e-2
#define RIDGE_FALLOF_SPEED 0.5

    float2 f1_f2 = cellular(noiseTextureIdx);

    if (abs(f1_f2.x - f1_f2.y) >= EPSILON)
    {
        return f1_f2.x;
    }

    if (f1_f2.x >= RANGE_THRSH_CEIL)
    {
        return f1_f2.x;
    }
    else if (f1_f2.x <= RANGE_THRSH_FLOOR)
    {
        return 0.0;
    }
    else
    {
        return ((f1_f2.x - RANGE_THRSH_FLOOR) * RIDGE_FALLOF_SPEED) / (RANGE_THRSH_CEIL - RANGE_THRSH_FLOOR);
    }
}

//these end up normalized and uniformly distributed
float2 computeNoiseCoordinates(uint2 targetTextureCoordinates, uint2 targetDimensions)
{
    float linearX = targetTextureCoordinates.y * targetDimensions.x + targetTextureCoordinates.x;
    float linearY = targetTextureCoordinates.x * targetDimensions.y + targetTextureCoordinates.y;
    float2 displacedCoordinates = float2(linearX, linearY) + targetDimensions * noiseDisplacement;
    float2 permutedCoordinates = permute(displacedCoordinates) / 289.0;
    return clamp(permutedCoordinates, 1.0e-3, 1.0);
}

#pragma kernel IntializeTexture
[numthreads(4, 4, 1)] void IntializeTexture(uint3 localId : SV_GroupThreadID, uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupID)
{
    uint2 targetDimensions;
    Result.GetDimensions(targetDimensions.x, targetDimensions.y);

    uint2 topLeftCellIdx = globalId.xy * threadDomainTexelWidth;

    float2 worleyCoordinates = (topLeftCellIdx / (float2)targetDimensions) * worleyFrequency + noiseDisplacement.xy * worleyFrequency; 
    Result[topLeftCellIdx.xy] = sampleWorleyNoise(worleyCoordinates) * octaveAmplitude;
    // Result[topLeftCellIdx] = sampleNoise(computeNoiseCoordinates(topLeftCellIdx, targetDimensions)) * octaveAmplitude;
}

#pragma kernel AddExtraNoise
[numthreads(4, 4, 1)] void AddExtraNoise(uint3 localId : SV_GroupThreadID, uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupID)
{
    uint2 targetDimensions;
    Result.GetDimensions(targetDimensions.x, targetDimensions.y);

    uint2 topLeftCellIdx = globalId.xy * threadDomainTexelWidth;

    for (int x = 0; x < threadDomainTexelWidth; ++x)
    {
        for (int y = 0; y < threadDomainTexelWidth; ++y)
        {
            uint2 targetIdx = topLeftCellIdx + uint2(x, y);
            Result[targetIdx] = Result[targetIdx] + sampleGaussianNoise(computeNoiseCoordinates(targetIdx, targetDimensions)) * octaveAmplitude;
        }
    }
}

#pragma kernel Transition12
[numthreads(4, 4, 1)] void Transition12(uint3 localId : SV_GroupThreadID, uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupID)
{
    uint2 targetDimensions;
    Result.GetDimensions(targetDimensions.x, targetDimensions.y);

    uint2 topLeftCellIdx = globalId.xy * threadDomainTexelWidth;

    for (int x = 0; x < texelWidthDivisionFactor; ++x)
    {
        for (int y = 0; y < texelWidthDivisionFactor; ++y)
        {
            int2 subdivisionIdx = topLeftCellIdx.xy + uint2(texelWidthDivided + 2 * texelWidthDivided * x, texelWidthDivided + 2 * texelWidthDivided * y);

            // let the terrain wrap around currently
            float averageNeighbors =
                (Result[terrainWrap(subdivisionIdx + int2(texelWidthDivided, texelWidthDivided), targetDimensions)] +
                 Result[terrainWrap(subdivisionIdx + int2(texelWidthDivided, -texelWidthDivided), targetDimensions)] +
                 Result[terrainWrap(subdivisionIdx + int2(-texelWidthDivided, texelWidthDivided), targetDimensions)] +
                 Result[terrainWrap(subdivisionIdx + int2(-texelWidthDivided, -texelWidthDivided), targetDimensions)]) /
                4.0;

            Result[subdivisionIdx] = averageNeighbors + sampleNoise(computeNoiseCoordinates(subdivisionIdx, targetDimensions)) * octaveAmplitude;
        }
    }
}

#pragma kernel Transition21
    [numthreads(4, 4, 1)] void Transition21(uint3 localID : SV_GroupThreadID, uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupID)
{
    uint2 targetDimensions;
    Result.GetDimensions(targetDimensions.x, targetDimensions.y);

    uint2 topLeftCellIdx = globalId.xy * threadDomainTexelWidth;

    int numYPasses = pow(2, texelWidthDivisionFactor);
    int numXPasses = texelWidthDivisionFactor;

    for (uint y = 0; y < numYPasses; ++y)
    {
        int xShiftAmount = (1 - (y % 2)) * texelWidthDivided;
        for (uint x = 0; x < numXPasses; ++x)
        {
            int2 diamondIdx = topLeftCellIdx.xy + uint2(x * 2 * texelWidthDivided + xShiftAmount, y * texelWidthDivided);

            float neighborLeft = 0.0;
            float neighborRight = 0.0;
            float neighborTop = 0.0;
            float neighborBottom = 0.0;

            int numberValid = 0;

            if (diamondIdx.x != 0)
            {
                neighborLeft = Result[terrainWrap(diamondIdx + int2(-texelWidthDivided, 0), targetDimensions)];
                numberValid++;
            }

            if (diamondIdx.x != targetDimensions.x - 1)
            {
                neighborRight = Result[terrainWrap(diamondIdx + int2(+texelWidthDivided, 0), targetDimensions)];
                numberValid++;
            }

            if (diamondIdx.y != 0)
            {
                neighborTop = Result[terrainWrap(diamondIdx + int2(0, -texelWidthDivided), targetDimensions)];
                numberValid++;
            }

            if (diamondIdx.y != targetDimensions.y - 1)
            {
                neighborBottom = Result[terrainWrap(diamondIdx + int2(0, +texelWidthDivided), targetDimensions)];
                numberValid++;
            }

            Result[diamondIdx] = ((neighborLeft +
                                   neighborRight +
                                   neighborTop +
                                   neighborBottom) /
                                  numberValid) +
                                 sampleNoise(computeNoiseCoordinates(diamondIdx, targetDimensions)) * octaveAmplitude;
        }
    }
}
