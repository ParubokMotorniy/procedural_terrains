#include "../../3rdparty/hlsl_noise/ashima/classicnoise2D.hlsl"

RWTexture2D<float> Result;
Texture2D<float> NoiseSource;

uniform int threadDomainTexelWidth;
uniform int texelWidthDivided;
uniform uint texelWidthDivisionFactor; // 1,2,4,8...

uniform uint threadSubdomainsX;
uniform uint threadSubdomainsY;

uniform float octaveAmplitude;
uniform float noiseFrequency;
uniform float4 noiseDisplacement;

// TODO: ensure neighboring noise values are independent
// TODO: try intializing the grid with worley instead of plain perlin
// TODO: consider wrapping the domain to avoid tons of if statements

float sampleNoise(uint2 noiseTextureIdx)
{
    return NoiseSource[noiseTextureIdx] * 2.0 - 1.0;
    // return NoiseSource[idx];
}

uint2 computeNoiseCoordinates(uint2 targetTextureCoordinates, uint2 targetDimensions, uint2 noiseDimensions)
{
    return frac((targetTextureCoordinates / (float2)targetDimensions) + noiseDisplacement.xy) * (float2)noiseDimensions;
}

#pragma kernel AddExtraNoise
[numthreads(16, 16, 1)] void AddExtraNoise(uint3 localId : SV_GroupThreadID, uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupID)
{
    uint2 noiseDimensions;
    NoiseSource.GetDimensions(noiseDimensions.x, noiseDimensions.y);

    uint2 targetDimensions;
    Result.GetDimensions(targetDimensions.x, targetDimensions.y);

    uint2 topLeftCellIdx = globalId.xy * threadDomainTexelWidth;

    for (int x = 0; x < threadDomainTexelWidth; ++x)
    {
        for (int y = 0; y < threadDomainTexelWidth; ++y)
        {
            uint2 targetIdx = topLeftCellIdx + uint2(x, y);
            Result[targetIdx] += sampleNoise(computeNoiseCoordinates(targetIdx, targetDimensions, noiseDimensions)) * octaveAmplitude;
        }
    }
}

#pragma kernel IntializeTexture
    [numthreads(16, 16, 1)] void IntializeTexture(uint3 localId : SV_GroupThreadID, uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupID)
{
    uint2 targetDimensions;
    Result.GetDimensions(targetDimensions.x, targetDimensions.y);

    uint2 noiseDimensions;
    NoiseSource.GetDimensions(noiseDimensions.x, noiseDimensions.y);

    uint2 topLeftCellIdx = globalId.xy * threadDomainTexelWidth;
    Result[topLeftCellIdx.xy] = sampleNoise(computeNoiseCoordinates(topLeftCellIdx, targetDimensions, noiseDimensions)) * octaveAmplitude;
    //  the heightmaps are always square, but hey
    // TODO: two border points remain uninitialized
    if (globalId.x == (threadSubdomainsX - 1) || globalId.y == (threadSubdomainsY - 1))
    {
        uint2 bottomRightCellIdx = topLeftCellIdx + threadDomainTexelWidth.xx;
        Result[bottomRightCellIdx] = sampleNoise(computeNoiseCoordinates(bottomRightCellIdx, targetDimensions, noiseDimensions)) * octaveAmplitude;
    }
}

#pragma kernel Transition12
[numthreads(16, 16, 1)] void Transition12(uint3 localId : SV_GroupThreadID, uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupID)
{
    uint2 noiseDimensions;
    NoiseSource.GetDimensions(noiseDimensions.x, noiseDimensions.y);

    uint2 targetDimensions;
    Result.GetDimensions(targetDimensions.x, targetDimensions.y);

    uint2 topLeftCellIdx = globalId.xy * threadDomainTexelWidth;

    for (int x = 0; x < texelWidthDivisionFactor; ++x)
    {
        for (int y = 0; y < texelWidthDivisionFactor; ++y)
        {
            int2 subdivisionIdx = topLeftCellIdx.xy + uint2(texelWidthDivided + 2 * texelWidthDivided * x, texelWidthDivided + 2 * texelWidthDivided * y);

            float averageNeighbors =
                (Result[subdivisionIdx + int2(texelWidthDivided, texelWidthDivided)] +
                 Result[subdivisionIdx + int2(texelWidthDivided, -texelWidthDivided)] +
                 Result[subdivisionIdx + int2(-texelWidthDivided, texelWidthDivided)] +
                 Result[subdivisionIdx + int2(-texelWidthDivided, -texelWidthDivided)]) /
                4.0;

            Result[subdivisionIdx] = averageNeighbors + sampleNoise(computeNoiseCoordinates(subdivisionIdx, targetDimensions, noiseDimensions)) * octaveAmplitude;
        }
    }
}

#pragma kernel Transition21
    [numthreads(16, 16, 1)] void Transition21(uint3 localID : SV_GroupThreadID, uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupID)
{
    uint width;
    uint height;
    Result.GetDimensions(width, height);

    uint2 noiseDimensions;
    NoiseSource.GetDimensions(noiseDimensions.x, noiseDimensions.y);

    uint2 topLeftCellIdx = globalId.xy * threadDomainTexelWidth;

    int xOnBoundary = (int)(globalId.x == (threadSubdomainsX - 1));
    int yOnBoundary = (int)(globalId.y == (threadSubdomainsY - 1));

    int numYPasses = pow(2, texelWidthDivisionFactor) + yOnBoundary;
    int numXPasses = texelWidthDivisionFactor;

    for (uint y = 0; y < numYPasses; ++y)
    {
        int xShiftAmount = (1 - (y % 2)) * texelWidthDivided;
        int numXIterations = numXPasses + xOnBoundary * (xShiftAmount == 0); // only considers boundary X if the row is not shifted
        for (uint x = 0; x < numXIterations; ++x)
        {
            int2 diamondIdx = topLeftCellIdx.xy + uint2(x * 2 * texelWidthDivided + xShiftAmount, y * texelWidthDivided);

            float neighborLeft = 0.0;
            float neighborRight = 0.0;
            float neighborTop = 0.0;
            float neighborBottom = 0.0;

            int numberValid = 0;

            if (diamondIdx.x != 0)
            {
                neighborLeft = Result[diamondIdx + int2(-texelWidthDivided, 0)];
                numberValid++;
            }

            if (diamondIdx.x != width - 1)
            {
                neighborRight = Result[diamondIdx + int2(+texelWidthDivided, 0)];
                numberValid++;
            }

            if (diamondIdx.y != 0)
            {
                neighborTop = Result[diamondIdx + int2(0, -texelWidthDivided)];
                numberValid++;
            }

            if (diamondIdx.y != height - 1)
            {
                neighborBottom = Result[diamondIdx + int2(0, +texelWidthDivided)];
                numberValid++;
            }

            Result[diamondIdx] = ((neighborLeft +
                                   neighborRight +
                                   neighborTop +
                                   neighborBottom) /
                                  numberValid) +
                                 sampleNoise(computeNoiseCoordinates(diamondIdx, uint2(width, height), noiseDimensions)) * octaveAmplitude;
        }
    }
}
