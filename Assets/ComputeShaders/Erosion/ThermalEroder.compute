#include "../Common/Utilities.hlsl"

RWTexture2D<float> resultHeightmap;
uniform int2 heightmapDimensions; // so as not to GetDimensions() every time

uniform int texelsPerThread;
uniform float distributionCoefficient; // this parameter now controls how "sturdy" the material constituting the terrain is
uniform int iterationIdx;
uniform float talusThreshold;

uniform uint permuteACore;
uniform uint permuteAStripH;
uniform uint permuteAStripV;

static const float BIG_FLOAT = 3.402823466e+38f;

#pragma multi_compile GLOBAL_GROUP_8 GLOBAL_GROUP_16 GLOBAL_GROUP_32 GLOBAL_GROUP_64

float computeUniformFloat(uint2 targetTextureCoordinates, int passId)
{
    uint seed = seedFromXYPass(targetTextureCoordinates.x, targetTextureCoordinates.y, passId);
    return u01FromUint(pcgHash(seed));
}

// diagonal texels are further away from the kernel center, and so we assume they receive less material than direct neighbors
static const float heightDistributionDistanceCoefficients[3][3] =
    {
        {0.85, 1.0, 0.85},
        {1.0, 0.0, 1.0},
        {0.85, 1.0, 0.85}};

struct TexelHeightDistribution
{
    float heightSpreadValue[3][3];
};

float computeSingleHeightIncrement(float heightDistance, float distanceSum, float totalHeightRemoved)
{
    return totalHeightRemoved * (heightDistance / distanceSum);
}

// determines how material is distirbuted around a texel due to thermal erosion
TexelHeightDistribution computeHeightDistribution(int2 processedTexel)
{
    TexelHeightDistribution nInfo;

    float texelHeight = resultHeightmap[processedTexel];

    float sumError = 0.0;
    float sumErrorOut = 0.0;
    float exceedingSum = 1.0e-5;
    float maxHeightDistance = 0.0;
    int numCriticalNeighbors = 0;
    float minHeightDistance = BIG_FLOAT;

    for (int x = -1; x < 2; ++x)
    {
        for (int y = -1; y < 2; ++y)
        {
            int2 ncoord = terrainWrap(processedTexel + int2(x, y), heightmapDimensions);
            float d = texelHeight - resultHeightmap[ncoord];

            if (d > talusThreshold)
            {
                maxHeightDistance = max(maxHeightDistance, d);
                minHeightDistance = min(minHeightDistance, d);
                numCriticalNeighbors++;
            }
            else
            {
                d = 0.0;
            }

            exceedingSum = accurateSum(exceedingSum, d, sumErrorOut);
            sumError += sumErrorOut;
            nInfo.heightSpreadValue[y + 1][x + 1] = d;
        }
    }
    exceedingSum += sumError;

    if (numCriticalNeighbors > 0)
    {
        float avalancheRatio = 0.0;
        // the smaller the distance betweem "average" neighbor -> the more prominent the "avalanche"
        float averageNeighborHeight = (texelHeight * (float)numCriticalNeighbors - exceedingSum) * rcp(numCriticalNeighbors);
        avalancheRatio = clamp(1.0 - (averageNeighborHeight / texelHeight), 0.0, 1.0);

        uint seed = seedFromXYPass(processedTexel.x, processedTexel.y, numCriticalNeighbors);
        float u1 = u01FromUint(pcgHash(seed));

        // zero-mean gaussian is shifted to the estimated ratio. u2 is kept at zero to ensure sigma=1
        float dynamicDistributionCoefficient = clamp(sampleGaussBoxMuller(float2(u1, 0.0)) + avalancheRatio, 0.3, 1.0) * distributionCoefficient;

        float localSoftness = computeSoftnessCoefficient(computeGradientAtPoint(resultHeightmap, heightmapDimensions, processedTexel), texelHeight, 0.1);
        float totalHeightRemoved = (numCriticalNeighbors > 0) ? localSoftness * dynamicDistributionCoefficient * (maxHeightDistance - talusThreshold) : 0.0;

        // to make sure the central texel does not end up higher than its closest neighbor
        float heightConsistencyThreshold = (minHeightDistance * exceedingSum) / (minHeightDistance + exceedingSum + 1.0e-5);
        totalHeightRemoved = (totalHeightRemoved <= heightConsistencyThreshold) ? totalHeightRemoved : heightConsistencyThreshold;

        for (int x = -1; x < 2; ++x)
        {
            for (int y = -1; y < 2; ++y)
            {
                float d = nInfo.heightSpreadValue[y + 1][x + 1];
                nInfo.heightSpreadValue[y + 1][x + 1] = heightDistributionDistanceCoefficients[y + 1][x + 1] * computeSingleHeightIncrement(d, exceedingSum, totalHeightRemoved);
            }
        }

        // how much height the central texel loses
        nInfo.heightSpreadValue[1][1] = -totalHeightRemoved;
    }

    return nInfo;
}

void applyKernel(int2 processedTexel)
{
    TexelHeightDistribution distributionAtTexel = computeHeightDistribution(processedTexel);
    for (int i = -1; i < 2; ++i)
    {
        for (int j = -1; j < 2; ++j)
        {
            int2 p = terrainWrap(processedTexel + int2(i, j), heightmapDimensions);
            resultHeightmap[p] += distributionAtTexel.heightSpreadValue[j + 1][i + 1];
        }
    }
}

// update of quadrants' centers
#pragma kernel ThermalCoreEroder
#if GLOBAL_GROUP_8
[numthreads(8, 8, 1)]
#elif GLOBAL_GROUP_16
[numthreads(16, 16, 1)]
#elif GLOBAL_GROUP_32
[numthreads(32, 32, 1)]
#endif
    void ThermalCoreEroder(uint3 localId : SV_GroupThreadID, uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupID)
{
    int2 topLeftCorner = int2(2, 2) + (int2)globalId.xy * texelsPerThread;
    float randomUniform = computeUniformFloat(topLeftCorner, iterationIdx * (groupId.x + groupId.y));

    int innerSide = texelsPerThread - 2;
    int totalTexelsPerThread = innerSide * innerSide;

    uint N = (uint)totalTexelsPerThread;
    uint permuteB = (1 + (int)(randomUniform * N)) % N;

    // iterates over the grid in a permuted order
    for (uint idx = 0; idx < N; ++idx)
    {
        uint permutedIdx = (permuteACore * idx + permuteB) % N;

        int x = (int)(permutedIdx / (uint)innerSide);
        int y = (int)(permutedIdx % (uint)innerSide);

        int2 processedTexel = topLeftCorner + int2(x, y);
        // resultHeightmap[topLeftCorner + int2((int)(idx / (uint)innerSide), (int)(idx % (uint)innerSide))] = permutedIdx;
        applyKernel(processedTexel);
        AllMemoryBarrier();
    }
}

// update of quadrants' borders
#pragma kernel ThermalBorderEroder
#if GLOBAL_GROUP_8
    [numthreads(8, 8, 1)]
#elif GLOBAL_GROUP_16
    [numthreads(16, 16, 1)]
#elif GLOBAL_GROUP_32
    [numthreads(32, 32, 1)]
#endif
    void ThermalBorderEroder(uint3 localId : SV_GroupThreadID, uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupID)
{
    int2 topLeftCorner = (int2)globalId.xy * texelsPerThread;
    float randomUniform = computeUniformFloat(topLeftCorner, iterationIdx * (groupId.x + groupId.y));

    int stepMultiplier = 1 - (texelsPerThread % 2);

    { // horizontal strip
        int totalTexelsPerThreadHorizontal = texelsPerThread * 2;

        uint N = (uint)totalTexelsPerThreadHorizontal;
        uint permuteBHorizontal = (1 + (int)(randomUniform * N)) % N;

        for (uint idx = 0; idx < N; ++idx)
        {
            uint permutedIdx = (permuteAStripH * idx + permuteBHorizontal) % N;

            int x = (int)(permutedIdx % (uint)texelsPerThread);
            int y = ((int)permutedIdx + (permutedIdx / texelsPerThread) * stepMultiplier) % 2;
            int2 processedTexel = topLeftCorner + int2(x, y);

            // resultHeightmap[topLeftCorner + int2((int)(idx / (uint)texelsPerThread), ((int)idx + (idx / texelsPerThread) * stepMultiplier) % 2)] = permutedIdx;
            applyKernel(processedTexel);
            AllMemoryBarrier();
        }
    }

    { // vertical strip
        int truncatedTexelsPerThread = texelsPerThread - 2;
        int totalTexelsPerThreadVertical = truncatedTexelsPerThread * 2;

        uint N = (uint)totalTexelsPerThreadVertical;
        uint permuteBVertical = (1 + (int)(randomUniform * N)) % N;

        for (uint idx = 0; idx < N; ++idx)
        {
            uint permutedIdx = (permuteAStripV * idx + permuteBVertical) % N;

            int y = (int)(permutedIdx % (uint)truncatedTexelsPerThread);
            int x = (permutedIdx + (permutedIdx / truncatedTexelsPerThread) * stepMultiplier) % 2;

            int2 processedTexel = topLeftCorner + int2(x, y) + int2(0, 2);

            // resultHeightmap[topLeftCorner + int2((int)(idx % (uint)truncatedTexelsPerThread), (idx + (permutedIdx / truncatedTexelsPerThread) * stepMultiplier) % 2)] = permutedIdx;
            applyKernel(processedTexel);
            AllMemoryBarrier();
        }
    }
}
