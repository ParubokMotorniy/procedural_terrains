#include "../../3rdparty/hlsl_noise/ashima/psrdnoise2D.hlsl"

uniform int texelsPerThread;
uniform float noiseFrequency;

uniform float sharpness;
uniform float slopeErosion;
uniform float perturbationStrength;
uniform float persistence;
uniform int numOctaves;
uniform uint2 textureDimensions; // to avoid GetDimensions()
uniform int2 randomInts;

// TODO: when possible, I should use analytical derivatives of the resulting terrain
RWTexture2D<float> Result;

#define PI 3.141592654

#pragma multi_compile GLOBAL_GROUP_8 GLOBAL_GROUP_16 GLOBAL_GROUP_32 GLOBAL_GROUP_64 

#pragma kernel UberNoiseTerrainGenerator
#if GLOBAL_GROUP_8
[numthreads(8, 8, 1)]
#elif GLOBAL_GROUP_16
[numthreads(16, 16, 1)]
#elif GLOBAL_GROUP_32
[numthreads(32, 32, 1)]
#endif
    void UberNoiseTerrainGenerator(uint3 id : SV_DispatchThreadID)
{
    uint2 topLeftThreadCorner = id.xy * texelsPerThread;
    float2 extraDisplacement = (float2)randomInts;

    for (int i = 0; i < texelsPerThread; ++i)
    {
        for (int j = 0; j < texelsPerThread; ++j)
        {
            int2 actualTextureIdx = topLeftThreadCorner + uint2(i, j);
            float2 floatIdx = extraDisplacement + (float2)actualTextureIdx;

            float2 slopeErosionDerivativeSum = clamp(sdnoise(floatIdx).x, -0.15, 0.15).xx;
            float2 perturbDerivativeSum = float2(0.0, 0.0);
            float noiseResult = 0.0;

            float octaveAmplitude = 1.0;
            float octaveFrequency = noiseFrequency;
            float2 samplePosition = float2(0.0, 0.0);

            for (int o = 0; o < numOctaves; ++o)
            {
                samplePosition = (floatIdx * octaveFrequency) + perturbDerivativeSum;

                float3 startNoiseValue = sdnoise(samplePosition);
                float featureNoise = startNoiseValue.x;
                float2 featureDerivative = startNoiseValue.yz;

                float ridgedNoise = 1.0 - abs(featureNoise);
                float billowNoise = ridgedNoise * ridgedNoise;
                featureNoise = lerp(featureNoise, billowNoise, max(0.0, sharpness));
                featureNoise = lerp(featureNoise, ridgedNoise, abs(min(0.0, sharpness)));
                // featureNoise *= exp(-dot(featureDerivative, featureDerivative)) * sharpness;

                slopeErosionDerivativeSum += featureDerivative * slopeErosion;
                perturbDerivativeSum += octaveAmplitude * perturbationStrength * featureDerivative;
                float derivativeNorm = dot(slopeErosionDerivativeSum, slopeErosionDerivativeSum);
                noiseResult += octaveAmplitude * featureNoise * (1.0f / (1.0f + derivativeNorm));

                octaveAmplitude *= persistence;
                octaveFrequency *= 2.0;
            }

            Result[actualTextureIdx] = noiseResult;
        }
    }
}
