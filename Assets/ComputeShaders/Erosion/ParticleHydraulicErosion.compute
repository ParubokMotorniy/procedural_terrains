#include "../Common/Utilities.hlsl"

struct ErosionParticle
{
    float2 pos;
    float2 dir;
    float vel;
    float w;
    float s;
};

struct TexelPipes
{
    float inPipes[3][3];
    float outPipes[3][3];
};

// the table only supports neighborhoods up to 3. Larger neighborhoods increase chances of races
static const uint2 pipeMap[7][7] =
    {
        {uint2(2, 2), uint2(2, 2), uint2(2, 1), uint2(2, 1), uint2(2, 1), uint2(2, 0), uint2(2, 0)},
        {uint2(2, 2), uint2(2, 2), uint2(2, 1), uint2(2, 1), uint2(2, 1), uint2(2, 0), uint2(2, 0)},
        {uint2(1, 2), uint2(1, 2), uint2(2, 2), uint2(2, 1), uint2(2, 0), uint2(1, 0), uint2(1, 0)},
        {uint2(1, 2), uint2(1, 2), uint2(1, 2), uint2(1, 1), uint2(1, 0), uint2(1, 0), uint2(1, 0)},
        {uint2(1, 2), uint2(1, 2), uint2(0, 2), uint2(0, 1), uint2(0, 0), uint2(1, 0), uint2(1, 0)},
        {uint2(0, 2), uint2(0, 2), uint2(0, 1), uint2(0, 1), uint2(0, 1), uint2(0, 0), uint2(0, 0)},
        {uint2(0, 2), uint2(0, 2), uint2(0, 1), uint2(0, 1), uint2(0, 1), uint2(0, 0), uint2(0, 0)}};
static const int pipeMapCenterCoord = 3;
static const int PLAIN_HEIGHT_THRESHOLD = 1.0e-3;

static const float depositionMapWeights[3][3] =
    {
        {0.02, 0.15, 0.02},
        {0.15, 0.3, 0.15},
        {0.02, 0.15, 0.02}};

RWTexture2D<float> resultHeightmap;
RWStructuredBuffer<ErosionParticle> particlesBuffer;
RWStructuredBuffer<TexelPipes> pipesBuffer;
uniform uint2 heightmapDimensions;
uniform uint particlesPerThread;
uniform uint texelsPerThread;

uniform float inertia;
uniform float capacity;
uniform float minSlope;
uniform float deposition;
uniform float erosion;
uniform float gravity;
uniform float evaporation;
uniform int erosionNeighborhood; // for 3x3 grid that would be 1, for 5x5 - 2
uniform float erosionDistanceSumPrecompute;
uniform int2 randomInts;
uniform float waterDeathThreshold;
uniform float rainNoiseFrequency;

// TODO: add hardness parameter

bool checkParticleIsValid(ErosionParticle particle)
{
    float2 particlePos = particle.pos;

    return (particlePos.x >= 0.0 && particlePos.y >= 0.0) && (particlePos.x < (float)heightmapDimensions.x && particlePos.y < (float)heightmapDimensions.y) && particle.w > waterDeathThreshold;
}

float sampleHeightmapBilinear(float2 coord)
{
    int2 basePart = int2(floor(coord));
    float2 fracPart = frac(coord);

    uint2 wrappedBase = terrainWrap(basePart, heightmapDimensions);

    float v00 = resultHeightmap[wrappedBase];
    float v10 = resultHeightmap[terrainWrap(basePart + int2(1, 0), heightmapDimensions)];
    float v01 = resultHeightmap[terrainWrap(basePart + int2(0, 1), heightmapDimensions)];
    float v11 = resultHeightmap[terrainWrap(basePart + int2(1, 1), heightmapDimensions)];

    float v0 = lerp(v00, v10, fracPart.x);
    float v1 = lerp(v01, v11, fracPart.x);

    return lerp(v0, v1, fracPart.y);
}

float removeSediment(int2 erosionCenter, float targetAmountToRemove)
{
    float actualSedimentRemoved = 0.0;
    float actualNeighborRadius = 1.5 * (float)erosionNeighborhood;
    for (int x = -1 * erosionNeighborhood; x <= erosionNeighborhood; ++x)
    {
        for (int y = -1 * erosionNeighborhood; y <= erosionNeighborhood; ++y)
        {
            float fx = (float)x;
            float fy = (float)y;

            float dist = sqrt(fx * fx + fy * fy);
            float weight = (actualNeighborRadius - dist) / max(erosionDistanceSumPrecompute, EPS);

            uint2 affectedNeighborCoordinate = terrainWrap(erosionCenter + int2(x, y), heightmapDimensions);
            float currentTexelHeight = resultHeightmap[affectedNeighborCoordinate];

            float localSoftness = computeSoftnessCoefficient(computeGradientAtPoint(resultHeightmap, heightmapDimensions, affectedNeighborCoordinate), currentTexelHeight, 0.1);
            float localAmountRemoved = min(currentTexelHeight, max(weight, 0.0) * targetAmountToRemove);

            actualSedimentRemoved += localAmountRemoved;

            uint2 targetOutPipe = pipeMap[x + pipeMapCenterCoord][y + pipeMapCenterCoord];
            pipesBuffer[index2dTo1d(heightmapDimensions, affectedNeighborCoordinate)].outPipes[targetOutPipe.x][targetOutPipe.y] += localAmountRemoved;
        }
    }

    return actualSedimentRemoved;
}

void depositSediment(int2 erosionCenter, float amountToDeposit)
{

    for (int x = -1; x <= 1; ++x)
    {
        for (int y = -1; y <= 1; ++y)
        {
            float increment = depositionMapWeights[x + 1.0][y + 1.0] * amountToDeposit;
            uint2 affectedNeighborCoordinates = terrainWrap(erosionCenter + int2(x, y), heightmapDimensions);
            uint2 targetInPipe = pipeMap[x + pipeMapCenterCoord][y + pipeMapCenterCoord];
            pipesBuffer[index2dTo1d(heightmapDimensions, affectedNeighborCoordinates)].inPipes[targetInPipe.x][targetInPipe.y] += increment;
        }
    }
}

float2 computeUniformRandomCoordinates(uint2 targetCoordinates, int nonce)
{
    uint seed = seedFromXYPass(targetCoordinates.x, targetCoordinates.y, nonce);
    float u1 = u01FromUint(pcgHash(seed));
    float u2 = u01FromUint(pcgHash(seed ^ 0x68BC21EBu));

    return float2(max(u1, EPS), max(u2, EPS));
}

#pragma kernel GarbageCollector
[numthreads(64, 1, 1)] void GarbageCollector(uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupThreadID)
{
    uint threadRangeStart = globalId.x * particlesPerThread;

    for (uint idx = 0; idx < particlesPerThread; ++idx)
    {
        uint processedParticleIdx = threadRangeStart + idx;
        if (checkParticleIsValid(particlesBuffer[processedParticleIdx]))
            continue;

        // reinitialize a dead particle
        float2 uniformCoefficients = computeUniformRandomCoordinates(uint2(globalId.x, processedParticleIdx), randomInts.x + randomInts.y);
        float dropSize = abs(sampleGaussBoxMuller(uniformCoefficients));

        particlesBuffer[processedParticleIdx].pos = uniformCoefficients * (float2)heightmapDimensions;
        particlesBuffer[processedParticleIdx].dir = float2(0.0, 0.0);
        particlesBuffer[processedParticleIdx].vel = dropSize;
        particlesBuffer[processedParticleIdx].w = dropSize;
        particlesBuffer[processedParticleIdx].s = 0.0;
    }
}

#pragma kernel ParticlesInitializer
    [numthreads(64, 1, 1)] void ParticlesInitializer(uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupThreadID)
{
    uint threadRangeStart = globalId.x * particlesPerThread;

    for (uint idx = 0; idx < particlesPerThread; ++idx)
    {
        uint processedParticleIdx = threadRangeStart + idx;

        float2 uniformCoefficients = computeUniformRandomCoordinates(uint2(globalId.x, processedParticleIdx), randomInts.x + randomInts.y);
        // float dropSize = abs(sampleGaussBoxMuller(uniformCoefficients));

        // here the pink noise accounts for the 'area' a particle covers.
        // While uniform coordinates guarantee uniform coverage of the entire area of the terrain,
        // pink-distributed size allows to achieve the typical 'rain' texture (implicitly)
        float dropSize = pinkNoise2D((uniformCoefficients + randomInts) * rainNoiseFrequency);

        particlesBuffer[processedParticleIdx].pos = uniformCoefficients * (float2)heightmapDimensions;
        particlesBuffer[processedParticleIdx].dir = float2(0.0, 0.0);
        particlesBuffer[processedParticleIdx].vel = dropSize;
        particlesBuffer[processedParticleIdx].w = dropSize;
        particlesBuffer[processedParticleIdx].s = 0.0;
    }
}

#pragma kernel PipesInitializer
[numthreads(32, 32, 1)] void PipesInitializer(uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupThreadID)
{
    uint2 threadTopLfetIndex = globalId.xy * texelsPerThread;
    for (int x = 0; x < texelsPerThread; ++x)
    {
        for (int y = 0; y < texelsPerThread; ++y)
        {
            uint targetTexelLin = index2dTo1d(heightmapDimensions, threadTopLfetIndex + uint2(x, y));
            for (int pX = 0; pX < 3; ++pX)
            {
                for (int pY = 0; pY < 3; ++pY)
                {
                    pipesBuffer[targetTexelLin].outPipes[pX][pY] = 0.0;
                    pipesBuffer[targetTexelLin].inPipes[pX][pY] = 0.0;
                }
            }
        }
    }
}

#pragma kernel Integrator
    [numthreads(64, 1, 1)] void Integrator(uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupThreadID)
{
    uint threadRangeStart = globalId.x * particlesPerThread;

    for (uint idx = 0; idx < particlesPerThread; ++idx)
    {
        uint processedParticleIdx = threadRangeStart + idx;
        if (!checkParticleIsValid(particlesBuffer[processedParticleIdx]))
            continue;

        float2 oldParticlePosition = particlesBuffer[processedParticleIdx].pos;
        float oldParticleVelocity = particlesBuffer[processedParticleIdx].vel;
        float oldSedimentValue = particlesBuffer[processedParticleIdx].s;
        float oldWaterValue = particlesBuffer[processedParticleIdx].w;

        int2 floorInt = int2(floor(oldParticlePosition));
        uint2 floorOldParticlePosition = terrainWrap(floorInt, heightmapDimensions);
        float2 interpolationCoefficients = frac(oldParticlePosition);

        float2 currentGradient = float2(
            (resultHeightmap[terrainWrap(
                 floorOldParticlePosition + uint2(1, 0), heightmapDimensions)] -
             resultHeightmap[floorOldParticlePosition]) *
                    (1.0 - interpolationCoefficients.y) +

                (resultHeightmap[terrainWrap(
                     floorOldParticlePosition + uint2(1, 1), heightmapDimensions)] -
                 resultHeightmap[terrainWrap(
                     floorOldParticlePosition + uint2(0, 1), heightmapDimensions)]) *
                    interpolationCoefficients.y,

            (resultHeightmap[terrainWrap(floorOldParticlePosition + uint2(0, 1), heightmapDimensions)] -
             resultHeightmap[floorOldParticlePosition]) *
                    (1.0 - interpolationCoefficients.x) +

                (resultHeightmap[terrainWrap(
                     floorOldParticlePosition + uint2(1, 1), heightmapDimensions)] -
                 resultHeightmap[terrainWrap(
                     floorOldParticlePosition + uint2(1, 0), heightmapDimensions)]) *
                    interpolationCoefficients.x);

        float2 dirCandidate = particlesBuffer[processedParticleIdx].dir * inertia - currentGradient * (1.0 - inertia);
        float2 newParticleDirection = (dot(dirCandidate, dirCandidate) > EPS) ? normalize(dirCandidate) : float2(0.0, 0.0);
        float2 newParticlePosition = oldParticlePosition + newParticleDirection;
        float oldHeight = sampleHeightmapBilinear(oldParticlePosition);
        float newHeight = sampleHeightmapBilinear(newParticlePosition);
        float heightDelta = newHeight - oldHeight;

        float sedimentValueUpdate = 0.0;
        if (heightDelta > PLAIN_HEIGHT_THRESHOLD)
        {
            float amountToDeposit = min(oldSedimentValue, max(abs(resultHeightmap[floorOldParticlePosition] - oldHeight), heightDelta));
            depositSediment(floorOldParticlePosition, amountToDeposit);
            sedimentValueUpdate = -amountToDeposit;
        }
        else if (heightDelta < -PLAIN_HEIGHT_THRESHOLD)
        {
            float newCapacity = max(-heightDelta, minSlope) * oldParticleVelocity * oldWaterValue * capacity;

            if ((oldSedimentValue - newCapacity) > EPS)
            {
                float amountToDeposit = (oldSedimentValue - newCapacity) * deposition;
                depositSediment(floorOldParticlePosition, amountToDeposit);
                sedimentValueUpdate = -amountToDeposit;
            }
            else if ((oldSedimentValue - newCapacity) < -EPS)
            {
                float amountToRemove = min((newCapacity - oldSedimentValue) * erosion, -heightDelta);
                sedimentValueUpdate = removeSediment(floorOldParticlePosition, amountToRemove);
            }
        }

        float newParticleVelocity = sqrt(abs(oldParticleVelocity * oldParticleVelocity - heightDelta * gravity));
        float newW = max(oldWaterValue * (1 - evaporation), 0.0);

        particlesBuffer[processedParticleIdx].pos = newParticlePosition;
        particlesBuffer[processedParticleIdx].dir = newParticleDirection;
        particlesBuffer[processedParticleIdx].vel = newParticleVelocity;
        particlesBuffer[processedParticleIdx].w = newW;
        particlesBuffer[processedParticleIdx].s = max(oldSedimentValue + sedimentValueUpdate, 0.0);
    }
}

#pragma kernel ChangeResolver
[numthreads(32, 32, 1)] void ChangeResolver(uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupThreadID)
{
    uint2 threadTopLeftIndex = globalId.xy * texelsPerThread;
    for (int x = 0; x < texelsPerThread; ++x)
    {
        for (int y = 0; y < texelsPerThread; ++y)
        {
            uint2 targetTexel = threadTopLeftIndex + uint2(x, y);
            uint targetTexelLin = index2dTo1d(heightmapDimensions, targetTexel);
            float totalSedimentRemoved = 0.0;
            float totalSedimentAdded = 0.0;
            for (int pX = 0; pX < 3; ++pX)
            {
                for (int pY = 0; pY < 3; ++pY)
                {
                    totalSedimentRemoved += pipesBuffer[targetTexelLin].outPipes[pX][pY];
                    totalSedimentAdded += pipesBuffer[targetTexelLin].inPipes[pX][pY];
                }
            }

            resultHeightmap[targetTexel] = max(resultHeightmap[targetTexel] + totalSedimentAdded - totalSedimentRemoved, 0.0);
        }
    }
}