#include "./Common/Utilities.hlsl"

RWTexture2D<float> resultHeightmap;
RWStructuredBuffer<float2> coefficients;
uniform int2 heightmapDimensions; // so as not to GetDimensions() every time
uniform int2 coefficientmapDimensions;
uniform int2 inverseDispatchGroupOffset;

uniform int2 texelsPerThread; // what fraction of the coefficients plane a thread processes

uniform int invTexelsPerThread; // what fraction of the coefficients plane a thread processes
uniform int texelsPerInverseGroup;

uniform float fractalDimension;

uniform int2 randomSeeds;

float2 computeUniformRandomCoordinates(uint2 targetTextureCoordinates, int passId)
{
    uint seed = seedFromXYPass(targetTextureCoordinates.x, targetTextureCoordinates.y, passId);
    float u1 = u01FromUint(pcgHash(seed));
    float u2 = u01FromUint(pcgHash(seed ^ 0x68BC21EBu));

    u1 = max(u1, EPS);

    return float2(u1, u2);
}

float2 getEffectiveCoefficient(uint2 mathematicalCoordinates)
{
    if (mathematicalCoordinates.x < coefficientmapDimensions.x && mathematicalCoordinates.y < coefficientmapDimensions.y)
    {
        return coefficients[index2dTo1d(coefficientmapDimensions, mathematicalCoordinates)];
    }

    uint2 targetSymmetricalCoefficient = (heightmapDimensions - uint2(1, 1)) - mathematicalCoordinates;

    if (mathematicalCoordinates.x == 0)
    {
        targetSymmetricalCoefficient.x = 0;
    }

    if (mathematicalCoordinates.y == 0)
    {
        targetSymmetricalCoefficient.y = 0;
    }

    float2 computedCoefficient = coefficients[index2dTo1d(coefficientmapDimensions, targetSymmetricalCoefficient)];

    return float2(computedCoefficient.x, -computedCoefficient.y);
}

#pragma kernel CoefficientGenerator
[numthreads(16, 16, 1)] void CoefficientGenerator(uint3 localId : SV_GroupThreadID, uint3 globalId : SV_DispatchThreadID, uint3 groupId : SV_GroupID)
{
    uint2 threadTopLeftCorner = globalId.xy * texelsPerThread;

    {
        for (int tX = 0; tX < texelsPerThread.x; ++tX)
        {
            for (int tY = 0; tY < texelsPerThread.y; ++tY)
            {
                uint2 coefficientCoordinates = threadTopLeftCorner + uint2(tX, tY);

                float2 randomUniform = computeUniformRandomCoordinates(coefficientCoordinates, randomSeeds.x);
                float randomGaussian = sampleGaussBoxMuller(randomUniform);

                // computing the coefficient
                float randomPhase = TWO_PI * randomUniform.x;
                float randomMagnitude = 0.0;

                if (coefficientCoordinates.x != 0 || coefficientCoordinates.y != 0)
                {
                    float2 c = (float2)coefficientCoordinates;
                    float d2 = dot(c, c);

                    d2 = max(d2, EPS);

                    randomMagnitude = pow(d2, -(fractalDimension + 1.0) / 2.0) * randomGaussian;
                }

                float2 baseCoefficient = randomMagnitude * float2(cos(randomPhase), sin(randomPhase));

                // base coefficient
                coefficients[index2dTo1d(coefficientmapDimensions, coefficientCoordinates)] = baseCoefficient;
            }
        }
    }
}

// in general, this thing wouldn't need multiple dispatches to complete. However, that would require thread barrier in a loop, which I find quite restrictive currently.
#pragma kernel InverseFFT
#define INV_GROUP_SIZE 16
groupshared float localHeightContributions[INV_GROUP_SIZE][INV_GROUP_SIZE];
[numthreads(INV_GROUP_SIZE, INV_GROUP_SIZE, 1)] void InverseFFT(uint3 localId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    uint2 threadTopLeftCorner = localId.xy * invTexelsPerThread;   // gives the top left corner in the coefficient map space
    uint2 groupTopLeftCorner = groupId.xy * texelsPerInverseGroup; // gives the top left corner in the textures space, prtocessed by a group

    uint2 targetHeightmapCoords = groupTopLeftCorner + inverseDispatchGroupOffset; // the heightmap texel to process as a group

    float2 exponentRatioPrecompute = (float2)targetHeightmapCoords / (float2)heightmapDimensions;

    float finalHeight = 0.0;
    float localErrorOut = 0.0;
    float localError = 0.0;
    for (int x = 0; x < invTexelsPerThread; ++x)
    {
        for (int y = 0; y < invTexelsPerThread; ++y)
        {
            uint2 coefficientCoords = threadTopLeftCorner + uint2(x, y);
            float2 coefficient = getEffectiveCoefficient(coefficientCoords);

            float ePower = TWO_PI * ((float)coefficientCoords.x * exponentRatioPrecompute.x + (float)coefficientCoords.y * exponentRatioPrecompute.y);
            float2 complexExponent = float2(cos(ePower), sin(ePower));

            float product = coefficient.x * complexExponent.x - coefficient.y * complexExponent.y;
            finalHeight = accurateSum(finalHeight, product, localErrorOut);
            localError += localErrorOut;
        }
    }
    localHeightContributions[localId.x][localId.y] = finalHeight + localError;

    // per-texel accumulation
    GroupMemoryBarrierWithGroupSync();

    if (localId.x == 0 && localId.y == 0)
    {
        float finalTexelHeight = 0.0;
        float errorOut = 0.0;
        float error = 0.0;
        for (int x = 0; x < INV_GROUP_SIZE; ++x)
        {
            for (int y = 0; y < INV_GROUP_SIZE; ++y)
            {
                finalTexelHeight = accurateSum(finalTexelHeight, localHeightContributions[x][y], errorOut);
                error += errorOut;
            }
        }
        resultHeightmap[targetHeightmapCoords] = finalTexelHeight + error;
    }
}
